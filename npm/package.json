{
  "name": "@tty-pt/xylem",
  "version": "1.8.0",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libxylem dynamic module hook and event bus",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cap": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    }
  },
  "files": [
    "dist",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include native/xylem_napi.c -L../lib -Wl,-rpath,../lib -L/usr/lib -lxylem -o build/Release/xylem_node.node 2>/dev/null || true",
    "build:wasm": "make -C .. wasm",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/xylem.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/stele": ">=1.6.0"
  },
  "devDependencies": {
    "@tty-pt/stele": "^1.6.0"
  },
  "keywords": [
    "xylem",
    "libxylem",
    "module",
    "hooks",
    "bus",
    "extensibility"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/libxylem.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/libxylem/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/libxylem/issues"
  }
}
